# Rojo / Roblox build output
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
build/
# Tooling
~/.rokit
# The Rojo binary this project keeps beside itself, and the archive it came in.
# scripts/update-rojo.sh downloads these; they are per-machine, not source.
/rojo
/rojo-*.zip
/rojo-*.tar.gz
.DS_Store
*.log

# Copies of anything Studio wrote back over the served tree, kept by dev.sh
# so an automatic reclaim can never be the thing that loses work. Per-machine.
/.rojo-writeback/
