{
  "name": "FadingLight",
  "globIgnorePaths": ["**/*.spec.lua", "**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 42,
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ShowDevelopmentGui": true
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 196.2,
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.2117, 0.1960, 0.1882],
        "OutdoorAmbient": [0.5176, 0.4156, 0.3294],
        "Brightness": 2.35,
        "ClockTime": 17.2,
        "GeographicLatitude": 41.6,
        "ExposureCompensation": 0.16,
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "Technology": "ShadowMap",
        "FogColor": [0.4627, 0.3607, 0.2745],
        "FogEnd": 1150,
        "FogStart": 150
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true,
        "DistanceFactor": 12,
        "RolloffScale": 1.2
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    }
  }
}
