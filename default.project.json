{
  "name": "FadingLight",
  "globIgnorePaths": ["**/*.spec.lua", "**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 42,
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ShowDevelopmentGui": true
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 196.2,
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.4705, 0.4705, 0.4901],
        "OutdoorAmbient": [0.7058, 0.7058, 0.7254],
        "Brightness": 3,
        "ClockTime": 13.5,
        "GeographicLatitude": 41.6,
        "ExposureCompensation": 0,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "Technology": "ShadowMap",
        "FogColor": [0.7843, 0.8039, 0.8392],
        "FogEnd": 100000,
        "FogStart": 50000
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true,
        "DistanceFactor": 12,
        "RolloffScale": 1.2
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    }
  }
}
